# Copy this file to `.env.local` and fill in values from
# Supabase Dashboard → Project Settings → API.
#
# Only VITE_-prefixed variables are exposed to browser code by Vite.
# Both values below are PUBLIC by design — security comes from RLS policies.
# NEVER put the service_role / secret key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
